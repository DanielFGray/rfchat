{
  "apiVersion": "roamancer/v2",
  "name": "rfchat",
  "postgres": [{ "database": "rfchat", "extensions": ["citext"], "shadow": false }],
  "valkey": {},
  "objectStore": {},
  "services": [
    {
      "name": "rfchat",
      "image": "registry.cluster:5000/rfchat",
      "hostPort": "dynamic",
      "containerPort": 4000,
      "healthCheck": { "type": "http", "path": "/health" },
      "cpu": 500,
      "memoryMB": 512,
      "networkMode": "bridge",
      "routes": [{ "access": "tailnet" }],
      "environment": [
        { "name": "PHX_SERVER", "value": "true" },
        { "name": "PORT", "value": "4000" },
        { "name": "DATABASE_VISITOR", "database": "rfchat", "role": "visitor" },
        { "name": "PHX_URL", "route": "rfchat" },
        { "name": "VALKEY_KEY_PREFIX", "valkey": "keyPrefix" },
        { "name": "TRUSTED_PROXY_HEADER", "value": "x-forwarded-for" }
      ],
      "connections": [],
      "migrate": {
        "command": "/app/bin/migrate",
        "secrets": [
          {
            "_tag": "PostgresCredentials",
            "database": "rfchat",
            "login": "migration",
            "urlEnv": "DATABASE_URL"
          },
          {
            "_tag": "GeneratedSecret",
            "key": "secret_key_base",
            "env": "SECRET_KEY_BASE",
            "bytes": 64
          },
          {
            "_tag": "ObjectStoreCredentials",
            "endpointEnv": "S3_ENDPOINT",
            "regionEnv": "S3_REGION",
            "bucketEnv": "S3_BUCKET",
            "accessKeyIdEnv": "S3_ACCESS_KEY_ID",
            "secretAccessKeyEnv": "S3_SECRET_ACCESS_KEY"
          }
        ]
      },
      "secrets": [
        {
          "_tag": "PostgresCredentials",
          "database": "rfchat",
          "login": "api",
          "urlEnv": "DATABASE_URL"
        },
        { "_tag": "ValkeyCredentials", "urlEnv": "REDIS_URL" },
        {
          "_tag": "GeneratedSecret",
          "key": "secret_key_base",
          "env": "SECRET_KEY_BASE",
          "bytes": 64
        },
        {
          "_tag": "ObjectStoreCredentials",
          "endpointEnv": "S3_ENDPOINT",
          "regionEnv": "S3_REGION",
          "bucketEnv": "S3_BUCKET",
          "accessKeyIdEnv": "S3_ACCESS_KEY_ID",
          "secretAccessKeyEnv": "S3_SECRET_ACCESS_KEY"
        }
      ]
    }
  ]
}
